# Demo conditions (single source of truth). Sourced by the scripts; any variable already set
# in the environment wins.

# Paths
: "${CARLA_ROOT:=$HOME/CARLA_0.9.16_pov}"    # stock CARLA 0.9.16 copy with PoV_Highway installed
: "${VP_DEMO_WORK:=$DEMO_DIR/work}"          # build outputs, staged config, logs (git-ignored)
: "${VP_CUDA_CACHE:=$HOME/.cache/vp_cuda}"   # persistent CUDA JIT cache for faster VP start

# Docker
: "${VP_DEMO_IMAGE:=vp-pov-highway:latest}"
: "${VP_DEMO_PREFIX:=vp_pov}"                # container names: <prefix>_{drive,scenario,speed,ctrl}

# CARLA server
: "${CARLA_WINDOWED:=0}"                     # 0: -RenderOffScreen, 1: render window on $DISPLAY
: "${CARLA_PORT:=2000}"
: "${TM_PORT:=8000}"

# Scenario (pov_highway.py traffic)
: "${NPC_KMH:=60}"                           # mean NPC target speed, +/-10 km/h per car
: "${NPC_COUNT:=30}"
: "${SEED:=7}"                               # seeds python random and the Traffic Manager

# VisionPilot (patched into the staged vision_pilot.conf by setup.sh)
: "${VP_SPEED_LIMIT_MS:=25.0}"
: "${VP_CAMERA_TOPIC:=/carla/hero/main_cam/image}"

# Rolling start (see README, "Standing start")
: "${KICKSTART_MS:=5.0}"

# Timeouts, s
: "${CARLA_START_TIMEOUT:=120}"
: "${SCENARIO_TIMEOUT:=180}"
: "${VP_PLAN_TIMEOUT:=300}"
